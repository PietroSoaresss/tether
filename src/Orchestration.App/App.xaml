<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Orchestration.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TetherCanvasBrush" Color="#1F1633" />
                    <SolidColorBrush x:Key="TetherToolbarBrush" Color="#150F23" />
                    <SolidColorBrush x:Key="TetherNodeBrush" Color="#241A3B" />
                    <SolidColorBrush x:Key="TetherNodeHeaderBrush" Color="#2A2042" />
                    <SolidColorBrush x:Key="TetherBorderBrush" Color="#362D59" />
                    <SolidColorBrush x:Key="TetherBorderStrongBrush" Color="#79628C" />
                    <SolidColorBrush x:Key="TetherTextPrimaryBrush" Color="#F5F3F7" />
                    <SolidColorBrush x:Key="TetherTextSecondaryBrush" Color="#C9C4D1" />
                    <SolidColorBrush x:Key="TetherTextMutedBrush" Color="#9E97AA" />
                    <SolidColorBrush x:Key="TetherControlBrush" Color="#241A3B" />
                    <SolidColorBrush x:Key="TetherControlHoverBrush" Color="#2A2042" />
                    <SolidColorBrush x:Key="TetherPrimaryActionBrush" Color="#F5F3F7" />
                    <SolidColorBrush x:Key="TetherPrimaryActionTextBrush" Color="#1F1633" />
                    <SolidColorBrush x:Key="TetherOverlayBrush" Color="#E6150F23" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TetherCanvasBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TetherToolbarBrush" Color="#F7F6FA" />
                    <SolidColorBrush x:Key="TetherNodeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TetherNodeHeaderBrush" Color="#F7F6FA" />
                    <SolidColorBrush x:Key="TetherBorderBrush" Color="#D8D4E2" />
                    <SolidColorBrush x:Key="TetherBorderStrongBrush" Color="#79628C" />
                    <SolidColorBrush x:Key="TetherTextPrimaryBrush" Color="#1F1633" />
                    <SolidColorBrush x:Key="TetherTextSecondaryBrush" Color="#554C68" />
                    <SolidColorBrush x:Key="TetherTextMutedBrush" Color="#756D85" />
                    <SolidColorBrush x:Key="TetherControlBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TetherControlHoverBrush" Color="#ECE9F1" />
                    <SolidColorBrush x:Key="TetherPrimaryActionBrush" Color="#150F23" />
                    <SolidColorBrush x:Key="TetherPrimaryActionTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TetherOverlayBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="TetherAccentLimeBrush" Color="#C2EF4E" />
            <SolidColorBrush x:Key="TetherAccentOnLimeBrush" Color="#1F1633" />
            <SolidColorBrush x:Key="TetherAccentVioletBrush" Color="#79628C" />
            <SolidColorBrush x:Key="TetherBadgeBrush" Color="#422082" />
            <SolidColorBrush x:Key="TetherDangerBrush" Color="#FF5C5C" />
            <SolidColorBrush x:Key="TetherDangerPressedBrush" Color="#D83A3A" />
            <SolidColorBrush x:Key="TetherTerminalBrush" Color="#0D0A13" />

            <Style x:Key="TetherToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource TetherControlBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TetherBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TetherPrimaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TetherToolbarButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource TetherPrimaryActionBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TetherPrimaryActionTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TetherPrimaryActionBrush}" />
            </Style>

            <Style x:Key="TetherIconButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TetherToolbarButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="TetherToolbarToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource TetherControlBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TetherBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TetherCanvasToolStyle"
                   TargetType="ToggleButton"
                   BasedOn="{StaticResource TetherToolbarToggleStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="TetherNodeActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="TetherProjectRowStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TetherNodeActionButtonStyle}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextSecondaryBrush}" />
            </Style>

            <Style x:Key="TetherProjectGroupStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,10,8,4" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextMutedBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TetherDangerNodeActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TetherNodeActionButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource TetherDangerBrush}" />
            </Style>

            <Style x:Key="TetherNodeActionToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="TetherSplitButtonStyle" TargetType="SplitButton">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource TetherControlBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TetherTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TetherBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

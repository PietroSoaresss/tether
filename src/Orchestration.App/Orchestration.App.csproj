<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Orchestration.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Unpackaged + self-contained: no MSIX signing and no separate runtime install while iterating. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- xterm.js and its host page ship on disk; the terminal never reaches the network. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestration.Core\Orchestration.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildTetherCli" BeforeTargets="Build">
    <MSBuild Projects="..\Orchestration.Cli\Orchestration.Cli.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU" />
  </Target>

  <Target Name="CopyTetherCli" AfterTargets="Build">
    <ItemGroup>
      <TetherCliFiles Include="..\Orchestration.Cli\bin\$(Configuration)\net8.0\win-x64\tether*" />
    </ItemGroup>
    <Copy SourceFiles="@(TetherCliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Orchestration.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Orchestration.App.Views">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource TetherCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource TetherToolbarBrush}"
                BorderBrush="{ThemeResource TetherBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Height="56" Padding="16,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="TETHER"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TetherTextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="15"
                               FontWeight="SemiBold"
                               CharacterSpacing="80" />
                    <Border Width="1"
                            Height="24"
                            Background="{ThemeResource TetherBorderBrush}" />
                    <Button x:Name="OpenProjectButton"
                            Style="{StaticResource TetherPrimaryButtonStyle}"
                            Click="OnOpenProject">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="ProjectLabel"
                                       Text="Abrir projeto"
                                       MaxWidth="220"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="NewTerminalButton"
                            Style="{StaticResource TetherToolbarButtonStyle}"
                            Click="OnNewTerminal"
                            ToolTipService.ToolTip="Escolha o agente, depois clique ou arraste no canvas">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                            <TextBlock x:Name="NewTerminalLabel" Text="Terminal" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TetherToolbarButtonStyle}"
                            Click="OnNewNote">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE70B;" FontSize="14" />
                            <TextBlock Text="Nota" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TetherToolbarButtonStyle}"
                            Click="OnNewBrowser">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                            <TextBlock Text="Navegador" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="ConnectionModeToggle"
                                  Style="{StaticResource TetherToolbarToggleStyle}"
                                  Checked="OnConnectionModeChanged"
                                  Unchecked="OnConnectionModeChanged"
                                  ToolTipService.ToolTip="Conectar: arraste entre quaisquer pontos dos nós">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            <TextBlock Text="Conectar" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource TetherIconButtonStyle}"
                            Click="OnToggleExplorer"
                            ToolTipService.ToolTip="Mostrar ou ocultar arquivos">
                        <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource TetherIconButtonStyle}"
                            Click="OnResetView"
                            ToolTipService.ToolTip="Ajustar zoom">
                        <FontIcon Glyph="&#xE9A6;" FontSize="15" />
                    </Button>
                    <Border MinWidth="52"
                            Height="28"
                            Padding="8,0"
                            CornerRadius="6"
                            BorderBrush="{ThemeResource TetherBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="ZoomLabel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TetherTextSecondaryBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="11" />
                    </Border>
                    <Button Style="{StaticResource TetherIconButtonStyle}"
                            Click="OnSettings"
                            ToolTipService.ToolTip="Configurações">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="288" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource TetherCanvasBrush}"
                    BorderBrush="{ThemeResource TetherBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Projetos"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TetherTextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Style="{StaticResource TetherNodeActionButtonStyle}"
                                Click="OnOpenProject"
                                ToolTipService.ToolTip="Abrir pasta">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="ProjectFilter"
                             Grid.Row="1"
                             Height="34"
                             Margin="10,4,10,8"
                             Padding="10,5"
                             PlaceholderText="Filtrar projetos"
                             TextChanged="OnProjectFilterChanged" />

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ProjectList"
                                        Margin="8,0,8,12"
                                        Spacing="2" />
                        </ScrollViewer>
                        <TextBlock x:Name="ProjectListEmpty"
                                   Margin="16,12"
                                   Foreground="{ThemeResource TetherTextMutedBrush}"
                                   FontSize="12"
                                   Text="Abra uma pasta para começar."
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>

            <views:CursorGrid x:Name="Viewport"
                  Grid.Column="1"
                  Background="{ThemeResource TetherCanvasBrush}"
                  SizeChanged="OnViewportSizeChanged"
                  PointerPressed="OnCanvasPointerPressed"
                  PointerMoved="OnCanvasPointerMoved"
                  PointerReleased="OnCanvasPointerReleased"
                  PointerWheelChanged="OnCanvasWheel">
                <Canvas x:Name="CanvasBackground"
                        Background="{ThemeResource TetherCanvasBrush}" />
                <Canvas x:Name="GridLines" IsHitTestVisible="False" />
                <Canvas x:Name="Annotations" />
                <Canvas x:Name="Wires" />
                <Canvas x:Name="World" />
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Spacing="8">
                    <Border Background="{ThemeResource TetherNodeBrush}"
                            BorderBrush="{ThemeResource TetherBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="5">
                        <StackPanel x:Name="CanvasToolRuler"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <ToggleButton x:Name="SelectCanvasTool"
                                          IsChecked="True"
                                          Tag="select"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Selecionar (V)">
                                <FontIcon Glyph="&#xE7C9;" FontSize="14" />
                            </ToggleButton>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Click="OnNewTerminal"
                                    ToolTipService.ToolTip="Novo terminal">
                                <FontIcon Glyph="&#xE756;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Click="OnNewNote"
                                    ToolTipService.ToolTip="Nova nota">
                                <FontIcon Glyph="&#xE70B;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Click="OnNewBrowser"
                                    ToolTipService.ToolTip="Novo navegador">
                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                            </Button>
                            <ToggleButton x:Name="TextCanvasTool"
                                          Tag="text"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Texto (T)">
                                <TextBlock Text="Aa" FontSize="13" FontWeight="SemiBold" />
                            </ToggleButton>
                            <ToggleButton x:Name="DrawCanvasTool"
                                          Tag="draw"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Desenhar (P)">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="ArrowCanvasTool"
                                          Tag="arrow"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Seta (A)">
                                <FontIcon Glyph="&#xE72A;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="RectCanvasTool"
                                          Tag="rect"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Retângulo (R)">
                                <FontIcon Glyph="&#xE739;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="EllipseCanvasTool"
                                          Tag="ellipse"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Elipse (O)">
                                <FontIcon Glyph="&#xE91F;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="DiamondCanvasTool"
                                          Tag="diamond"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Losango (D)">
                                <!-- A losango is the square glyph turned 45°: no second glyph to hunt for. -->
                                <FontIcon Glyph="&#xE739;"
                                          FontSize="13"
                                          RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </ToggleButton>
                            <ToggleButton x:Name="EraseCanvasTool"
                                          Tag="erase"
                                          Style="{StaticResource TetherCanvasToolStyle}"
                                          Click="OnCanvasToolClick"
                                          ToolTipService.ToolTip="Apagar desenho (E)">
                                <FontIcon Glyph="&#xE75C;" FontSize="14" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CanvasContextBar"
                            Background="{ThemeResource TetherNodeBrush}"
                            BorderBrush="{ThemeResource TetherBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="CanvasContextLabel"
                                       Text="Ferramenta"
                                       Margin="2,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TetherTextMutedBrush}"
                                       FontSize="11" />
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#F5F3F7"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#F5F3F7" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#79628C"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#79628C" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#4CA6FF"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#4CA6FF" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#43C6AC"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#43C6AC" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#C2EF4E"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#C2EF4E" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="#F1C75B"
                                    Click="OnCanvasColor">
                                <Ellipse Width="15" Height="15" Fill="#F1C75B" />
                            </Button>
                            <StackPanel x:Name="CanvasTextGroup"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                <Border Width="1"
                                        Height="20"
                                        Margin="3,0"
                                        Background="{ThemeResource TetherBorderBrush}" />
                                <ToggleButton x:Name="TextFontUi"
                                              Tag="ui"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextFont"
                                              ToolTipService.ToolTip="Fonte da interface">
                                    <TextBlock Text="Aa" FontFamily="Segoe UI Variable Text" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextFontSerif"
                                              Tag="serif"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextFont"
                                              ToolTipService.ToolTip="Fonte com serifa">
                                    <TextBlock Text="Aa" FontFamily="Georgia" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextFontMono"
                                              Tag="mono"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextFont"
                                              ToolTipService.ToolTip="Fonte monoespaçada">
                                    <TextBlock Text="Aa" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                </ToggleButton>

                                <Border Width="1"
                                        Height="20"
                                        Margin="3,0"
                                        Background="{ThemeResource TetherBorderBrush}" />
                                <ToggleButton x:Name="TextBoldToggle"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextBold"
                                              ToolTipService.ToolTip="Negrito">
                                    <TextBlock Text="B" FontSize="13" FontWeight="Bold" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextItalicToggle"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextItalic"
                                              ToolTipService.ToolTip="Itálico">
                                    <TextBlock Text="I" FontSize="13" FontStyle="Italic" />
                                </ToggleButton>

                                <Border Width="1"
                                        Height="20"
                                        Margin="3,0"
                                        Background="{ThemeResource TetherBorderBrush}" />
                                <ToggleButton x:Name="TextAlignLeft"
                                              Tag="left"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextAlign"
                                              ToolTipService.ToolTip="Alinhar à esquerda">
                                    <FontIcon Glyph="&#xE8E4;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextAlignCenter"
                                              Tag="center"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextAlign"
                                              ToolTipService.ToolTip="Centralizar">
                                    <FontIcon Glyph="&#xE8E3;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextAlignRight"
                                              Tag="right"
                                              Style="{StaticResource TetherCanvasToolStyle}"
                                              Click="OnCanvasTextAlign"
                                              ToolTipService.ToolTip="Alinhar à direita">
                                    <FontIcon Glyph="&#xE8E2;" FontSize="13" />
                                </ToggleButton>
                            </StackPanel>

                            <Border x:Name="CanvasSizeDivider"
                                    Width="1"
                                    Height="20"
                                    Margin="3,0"
                                    Background="{ThemeResource TetherBorderBrush}" />
                            <Button x:Name="CanvasSizeDown"
                                    Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="-1"
                                    Click="OnCanvasSize">
                                <FontIcon Glyph="&#xE738;" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="CanvasSizeLabel"
                                       Text="3"
                                       MinWidth="24"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TetherTextSecondaryBrush}"
                                       FontFamily="Cascadia Mono"
                                       FontSize="11" />
                            <Button x:Name="CanvasSizeUp"
                                    Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Tag="1"
                                    Click="OnCanvasSize">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Bottom-left: the tool ruler owns the top centre, and a strip up there collides
                     with it the moment either grows. Sheet tabs at the bottom is also the shape
                     people already know from a spreadsheet. -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="12"
                        Background="{ThemeResource TetherNodeBrush}"
                        BorderBrush="{ThemeResource TetherBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="5">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2" />
                        <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                Click="OnNewTab"
                                ToolTipService.ToolTip="Novo canvas">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="RecoveryBar"
                         Severity="Warning"
                         IsOpen="False"
                         VerticalAlignment="Top"
                         Margin="12" />
            </views:CursorGrid>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="2"
                    Background="{ThemeResource TetherCanvasBrush}"
                    BorderBrush="{ThemeResource TetherBorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,0"
                          Background="{ThemeResource TetherToolbarBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Arquivos"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TetherTextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Click="OnRefreshFiles"
                                    ToolTipService.ToolTip="Atualizar arquivos">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource TetherNodeActionButtonStyle}"
                                    Click="OnToggleExplorer"
                                    ToolTipService.ToolTip="Fechar explorador">
                                <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ExplorerPathText"
                               Grid.Row="1"
                               Margin="12,10,12,6"
                               Foreground="{ThemeResource TetherTextMutedBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="2">
                        <TreeView x:Name="FileTree"
                                  Background="Transparent"
                                  Foreground="{ThemeResource TetherTextSecondaryBrush}"
                                  FontFamily="Segoe UI Variable Text"
                                  FontSize="12"
                                  SelectionMode="Single"
                                  Expanding="OnFileTreeExpanding" />
                        <TextBlock x:Name="FileTreeEmptyText"
                                   Visibility="Collapsed"
                                   Margin="16"
                                   Text="Pasta indisponível"
                                   Foreground="{ThemeResource TetherTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

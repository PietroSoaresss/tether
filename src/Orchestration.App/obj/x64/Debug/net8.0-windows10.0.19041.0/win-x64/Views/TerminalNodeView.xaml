<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Orchestration.App.Views.TerminalNodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:ConnectionId='2' x:Name="HeaderBar"
                  Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                  Padding="10,6"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:ConnectionId='7' x:Name="StateDot" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center" />
                <TextBlock x:ConnectionId='8' x:Name="TitleText" Grid.Column="1" Text="terminal"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" FontWeight="SemiBold" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:ConnectionId='9' x:Name="RestartButton"                   Padding="6,2"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Reiniciar">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                    <Button x:ConnectionId='10' x:Name="KillButton"                Padding="6,2"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Encerrar processo">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button x:ConnectionId='11' x:Name="CloseButton"                 Padding="6,2"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Remover no">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <controls:WebView2 x:ConnectionId='3' x:Name="Web" DefaultBackgroundColor="#0C0C0C" />
                <Border x:ConnectionId='4' x:Name="ExitOverlay" Visibility="Collapsed"
                        Background="#CC101010" Padding="16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock x:ConnectionId='5' x:Name="ExitText" Foreground="#DDD" TextAlignment="Center" />
                        <Button x:ConnectionId='6' Content="Reiniciar"                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

